# ==============================================================================
# JIO WIFI DATA TRACKER CONFIGURATION
# ==============================================================================
# Router Configuration (JioFiber / JioAirFiber)
ROUTER_HOST=192.168.29.1
ROUTER_USERNAME=admin
ROUTER_PASSWORD=your_router_password_here

# Application Mode: 'mock' (for development/testing) or 'real' (physical router)
MODE=mock

# Timing / Intervals (in seconds)
COLLECTION_INTERVAL=60
DASHBOARD_REFRESH_INTERVAL=15

# Timezone (All user-visible calculations MUST use Asia/Kolkata)
TIMEZONE=Asia/Kolkata

# Database Configuration & Retention
DATABASE_PATH=data/traffic.db
# Days of historical traffic to retain (0 = keep indefinitely)
DATA_RETENTION_DAYS=0

# Web Server Configuration
PORT=5000
HOST=0.0.0.0

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
